# .gitignore - 部署前需要提交到 GitHub

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# 项目特定
exported_data/
*.csv
.env

# Streamlit
.streamlit/secrets.toml

# 运行日志（自动生成，不入库）
logs/*.log

# SQLite 数据库（本地数据，不入库）
data/*.db
data/*.db-shm
data/*.db-wal
